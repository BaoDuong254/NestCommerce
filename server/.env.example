# Database connection string
DATABASE_URL="postgresql://<<username>>:<<password>>@localhost:5432/ecommerce-nestjs?schema=public"

# Admin initial credentials
ADMIN_PASSWORD=your-admin-password
ADMIN_EMAIL=your-admin-email
ADMIN_NAME="your-admin-name"
ADMIN_PHONE_NUMBER=your-admin-phone-number

# JWT configuration
ACCESS_TOKEN_SECRET=your-access-token-secret
ACCESS_TOKEN_EXPIRES_IN=1H
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRES_IN=1D

# API Key for external services
SECRET_API_KEY=your-secret-api-key

# OTP expiration time in minutes
OTP_EXPIRES_IN=5M

# Resend API Key for email services, get it from https://resend.com
RESEND_API_KEY=your-resend-api-key
