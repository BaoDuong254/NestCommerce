{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "preinstall": "pnpm dlx only-allow pnpm",
    "clean": "rimraf dist/",
    "email:dev": "email dev --dir src/shared/emails --port 3001",
    "email:build": "email build --dir src/shared/emails",
    "email:export": "email export --dir src/shared/emails",
    "seed": "ts-node -r tsconfig-paths/register scripts/index.ts",
    "seed:roles": "ts-node -r tsconfig-paths/register scripts/seed-roles.ts",
    "seed:permissions": "ts-node -r tsconfig-paths/register scripts/seed-permissions.ts",
    "seed:brands": "ts-node -r tsconfig-paths/register scripts/seed-brands.ts",
    "seed:categories": "ts-node -r tsconfig-paths/register scripts/seed-categories.ts"
  },
  "engines": {
    "node": "24.12.0",
    "pnpm": "10.27.0"
  },
  "dependencies": {
    "@apollo/server": "5.2.0",
    "@as-integrations/express5": "1.1.2",
    "@aws-sdk/client-s3": "3.958.0",
    "@aws-sdk/lib-storage": "3.958.0",
    "@aws-sdk/s3-request-presigner": "3.958.0",
    "@keyv/redis": "5.1.5",
    "@nestjs/apollo": "13.2.3",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/cache-manager": "3.1.0",
    "@nestjs/common": "^11.1.11",
    "@nestjs/core": "^11.1.11",
    "@nestjs/graphql": "13.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/platform-socket.io": "11.1.11",
    "@nestjs/schedule": "6.1.0",
    "@nestjs/swagger": "11.2.3",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.11",
    "@prisma/adapter-pg": "7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/client-runtime-utils": "7.2.0",
    "@react-email/components": "1.0.3",
    "@react-email/render": "2.0.1",
    "@socket.io/redis-adapter": "8.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "bcrypt": "^6.0.0",
    "bullmq": "5.66.4",
    "cache-manager": "7.2.7",
    "cacheable": "2.3.1",
    "chalk": "5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "google-auth-library": "10.5.0",
    "googleapis": "169.0.0",
    "graphql": "16.12.0",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "jsonwebtoken": "^9.0.3",
    "keyv": "5.5.5",
    "lodash": "4.17.21",
    "mime-types": "3.0.2",
    "ms": "^2.1.3",
    "multer": "2.0.2",
    "nestjs-i18n": "10.6.0",
    "nestjs-pino": "4.5.0",
    "nestjs-zod": "^5.0.1",
    "otpauth": "9.4.1",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "redis": "5.10.0",
    "redlock": "5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "resend": "6.6.0",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.2",
    "uuid": "13.0.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.11",
    "@react-email/preview-server": "5.1.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "4.17.21",
    "@types/mime-types": "3.0.1",
    "@types/multer": "2.0.0",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.12.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "prisma": "^7.2.0",
    "prisma-json-types-generator": "4.0.1",
    "react-email": "5.1.1",
    "rimraf": "6.1.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
