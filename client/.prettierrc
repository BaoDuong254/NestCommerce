{
  "arrowParens": "always",
  "semi": true,
  "trailingComma": "es5",
  "tabWidth": 2,
  "endOfLine": "lf",
  "useTabs": false,
  "singleQuote": false,
  "printWidth": 120,
  "jsxSingleQuote": true,
  "overrides": [
    {
      "files": ["**/*.jsonc", "tsconfig*.json"],
      "options": { "trailingComma": "none" }
    }
  ]
}
