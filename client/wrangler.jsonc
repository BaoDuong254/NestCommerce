{
  "name": "nestcommerce-client",
  "compatibility_date": "2026-10-15",
  "routes": [
    {
      "pattern": "nestcommerce.duonggiabao.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "issues": {
      "enabled": true
    }
  }
}
